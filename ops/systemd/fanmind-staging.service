[Unit]
Description=FanMind isolated staging application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=fanmind-staging
Group=fanmind-staging
WorkingDirectory=/var/www/fanmind-staging
EnvironmentFile=/var/www/fanmind-staging/.env.production
EnvironmentFile=/etc/fanmind-staging/runtime-secrets.env
EnvironmentFile=/var/www/fanmind-staging/.release.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/fanmind-staging

[Install]
WantedBy=multi-user.target
