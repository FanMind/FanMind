[Unit]
Description=FanMind email-disabled operations monitor lifecycle acceptance
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=-/var/www/fanmind/.env.production
Environment=FANMIND_OPERATIONS_MONITOR_ENABLED=true
Environment=FANMIND_OPERATIONS_EMAIL_ENABLED=false
Environment=FANMIND_OPERATIONS_REQUIRE_HEALTHY=false
Environment=FANMIND_OPERATIONS_LIFECYCLE_ACCEPTANCE_ACK=operations-monitor-production-lifecycle
ExecStart=/usr/bin/flock --exclusive --wait 120 /run/lock/fanmind-operations-monitor.lock /usr/bin/node /usr/local/lib/fanmind-monitor/operations-monitor-lifecycle.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/lock
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
