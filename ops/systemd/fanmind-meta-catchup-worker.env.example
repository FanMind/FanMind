# Copy to /etc/fanmind-meta-catchup/worker.env with mode 600 and root ownership.
# The preparation change does not install, enable, or start the worker.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FANMIND_META_CATCHUP_QUEUE_ENABLED=true
FANMIND_META_CATCHUP_INTERNAL_ORIGIN=http://127.0.0.1:3000
FANMIND_META_CATCHUP_WORKER_SECRET=
FANMIND_META_CATCHUP_WORKER_ID=fanmind-staging-meta-catchup
FANMIND_META_CATCHUP_POLL_MS=5000
