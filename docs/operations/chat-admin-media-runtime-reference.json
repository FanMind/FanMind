        "qual": "(is_current_chat_admin_workspace(workspace_id) AND deleted AND (NOT (EXISTS ( SELECT 1\n   FROM storage.objects o\n  WHERE ((o.bucket_id = 'chat-character-media'::text) AND (o.name = ((((((chat_character_media.workspace_id)::text || '/'::text) || (chat_character_media.character_id)::text) || '/'::text) || (chat_character_media.id)::text) || '.webp'::text)))))))",
