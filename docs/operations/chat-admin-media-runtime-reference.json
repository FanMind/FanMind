    "functions": [
      {
        "acl": [
          {
            "role": "postgres",
            "grantable": false,
            "privilege": "EXECUTE"
          }
        ],
        "args": "",
        "name": "chat_admin_media_object_guard",
        "owner": "postgres",
        "definition": "CREATE OR REPLACE FUNCTION public.chat_admin_media_object_guard()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\ndeclare target_workspace uuid; target_character uuid;\nbegin\n if new.bucket_id<>'chat-character-media' then return new; end if;\n select c.workspace_id,c.id into target_workspace,target_character\n from public.chat_characters c join public.chat_character_media m\n on m.workspace_id=c.workspace_id and m.character_id=c.id\n where new.name=m.workspace_id::text||'/'||m.character_id::text||'/'||m.id::text||'.webp'\n for update of c;\n if not found then raise exception 'media_object_binding_invalid'; end if;\n if not public.chat_admin_media_writes_allowed(target_workspace) or not exists(\n select 1 from public.chat_character_media m join public.chat_characters c\n on c.workspace_id=m.workspace_id and c.id=m.character_id\n where m.workspace_id=target_workspace and m.character_id=target_character\n and not m.deleted and c.status='active'\n and new.name=m.workspace_id::text||'/'||m.character_id::text||'/'||m.id::text||'.webp')\n then raise exception 'media_object_binding_invalid'; end if;\n return new;\nend;$function$\n"
      },
      {
        "acl": [
          {
            "role": "postgres",
            "grantable": false,
            "privilege": "EXECUTE"
          },
          {
            "role": "service_role",
            "grantable": false,
            "privilege": "EXECUTE"
          }
        ],
        "args": "",
        "name": "chat_admin_media_revision",
        "owner": "postgres",
        "definition": "CREATE OR REPLACE FUNCTION public.chat_admin_media_revision()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nbegin\n if TG_OP='UPDATE' then new.revision:=old.revision+1; end if;\n update public.chat_characters set revision=revision+1,updated_at=now()\n where workspace_id=case when TG_OP='DELETE' then old.workspace_id else new.workspace_id end\n and id=case when TG_OP='DELETE' then old.character_id else new.character_id end;\n if TG_OP='INSERT' and TG_TABLE_NAME='chat_character_media' and\n (select count(*) from public.chat_character_media m where m.workspace_id=new.workspace_id and m.character_id=new.character_id)>=100\n then raise exception 'media_library_limit'; end if;\n if TG_OP='DELETE' then return old; end if; return new;\nend;$function$\n"
      },
      {
        "acl": [
          {
            "role": "authenticated",
            "grantable": false,
            "privilege": "EXECUTE"
          },
          {
            "role": "postgres",
            "grantable": false,
            "privilege": "EXECUTE"
          }
        ],
        "args": "target_workspace uuid",
        "name": "chat_admin_media_writes_allowed",
        "owner": "postgres",
        "definition": "CREATE OR REPLACE FUNCTION public.chat_admin_media_writes_allowed(target_workspace uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select auth.uid() is not null and public.is_current_chat_admin_workspace(target_workspace)\n and not exists(select 1 from public.account_deletion_requests r where r.user_id=auth.uid() and r.status='processing')\n$function$\n"
      }
    ]
  }
