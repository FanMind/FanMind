{
  "name": "@fanmind/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:dev-client": "expo start --dev-client",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/check-expo-doctor.mjs",
    "fcm:check": "node scripts/check-android-fcm-config.mjs",
    "store:render": "node scripts/render-store-assets.mjs",
    "store:check": "node scripts/check-store-readiness.mjs",
    "boundary": "node scripts/check-boundary.mjs",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "native:prebuild:check": "node scripts/check-native-prebuild.mjs",
    "check": "npm run typecheck && npm run doctor && npm run fcm:check && npm run store:check && npm run boundary && npm run native:prebuild:check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "expo": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.2.3",
    "expo-doctor": "1.20.1",
    "sharp": "0.35.5",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
