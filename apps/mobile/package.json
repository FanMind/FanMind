{
  "name": "@fanmind/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:dev-client": "expo start --dev-client",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/check-expo-doctor.mjs",
    "store:render": "node scripts/render-store-assets.mjs",
    "store:check": "node scripts/check-store-readiness.mjs",
    "boundary": "node scripts/check-boundary.mjs",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "native:prebuild:check": "node scripts/check-native-prebuild.mjs",
    "check": "npm run typecheck && npm run doctor && npm run store:check && npm run boundary && npm run native:prebuild:check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "expo": "~57.0.20",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.12.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "expo-doctor": "1.20.1",
    "sharp": "0.35.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
