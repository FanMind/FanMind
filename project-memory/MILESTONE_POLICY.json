{
  "schema_version": 1,
  "directory": "project-memory/milestones",
  "required_fields": ["schema_version", "milestone", "snapshot_date", "snapshot_commit", "state", "evidence", "open_followups"],
  "milestones": [
    "MEMORY_V6_ACCEPTED",
    "STAGING_ACCEPTED",
    "RESTORE_ACCEPTED",
    "MOBILE_ACCEPTED",
    "AI_BILLING_ACCEPTED",
    "META_SECURITY_ACCEPTED",
